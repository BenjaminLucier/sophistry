{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/.vitepress/cache",
			"!**/*.gen.ts",
			"!**/.astro",
			"!**/.examples*",
			"!docs/public",
			"!e2e/test-results",
			"!test-results",
			"!playwright-report",
			"!e2e/report"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/{core,text,charts,3d,solidjs,react}/src/**",
				"packages/{core,text,charts,3d,solidjs,react}/*.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": {
							"level": "error",
							"fix": "safe",
							"options": {
								"forceJsExtensions": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": [
				"packages/solidjs/**",
				"docs/**",
				"apps/**",
				"**/*.test.tsx",
				"**/*.test.ts"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	],
	"markdown": {
		"formatter": {
			"enabled": false
		}
	}
}
