---
// Replaces Starlight's Banner: keeps per-page `banner` frontmatter working and
// adds a prominent early-release warning to every page. Dismissing it lasts
// until the next version, so each release shows it again.
import { version } from "../../../packages/core/package.json";

const { banner } = Astro.locals.starlightRoute.entry.data;
---

<div class="release-notice" id="release-notice" data-version={version} data-pagefind-ignore>
	<p>
		<strong>⚠ Early release: v{version}.</strong>
		sophistry is not ready for production use. Until 1.0, any minor release
		may break the API; expect missing features and bugs too.
		<a href="/project/stability/">Stability and versioning</a>
	</p>
	<button type="button" class="dismiss" aria-label="Dismiss notice">×</button>
</div>
<script is:inline>
	(function () {
		var el = document.getElementById("release-notice");
		var key = "sophistry-notice-dismissed";
		try {
			if (localStorage.getItem(key) === el.dataset.version) el.hidden = true;
		} catch (e) {}
		el.querySelector(".dismiss").addEventListener("click", function () {
			el.hidden = true;
			try {
				localStorage.setItem(key, el.dataset.version);
			} catch (e) {}
		});
	})();
</script>
{banner && <div class="sl-banner" data-pagefind-ignore set:html={banner.content} />}

<style>
	.release-notice {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 0.75rem 1rem;
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		text-align: center;
		border-bottom: 2px solid var(--sl-color-orange);
	}
	.release-notice[hidden] {
		display: none;
	}
	.release-notice p {
		margin: 0;
		max-width: 60rem;
	}
	.release-notice strong {
		font-size: var(--sl-text-base);
		margin-inline-end: 0.25rem;
	}
	.release-notice a {
		color: inherit;
		font-weight: 600;
		text-decoration: underline;
		white-space: nowrap;
	}
	.dismiss {
		appearance: none;
		flex: none;
		border: 0;
		background: none;
		color: inherit;
		font-size: 1.25rem;
		line-height: 1;
		padding: 0.15rem 0.4rem;
		cursor: pointer;
		border-radius: 0.3rem;
	}
	.dismiss:hover {
		background: color-mix(in srgb, currentColor 15%, transparent);
	}
	.sl-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
		color: var(--sl-color-banner-text, var(--sl-color-text-invert));
		text-align: center;
	}
	.sl-banner :global(a) {
		color: inherit;
	}
</style>
